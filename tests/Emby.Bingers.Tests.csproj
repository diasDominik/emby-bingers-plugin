<Project Sdk="Microsoft.NET.Sdk">
  <!-- End-to-end test: the plugin's own source compiled against in-memory Emby stand-ins
       (FakeEmby.cs) and driven against fake_bingers.py. Start the server first:
         python3 fake_bingers.py 8765 &
         dotnet run                                                                      -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FakeEmby.cs;Program.cs" />
    <Compile Include="../*.cs;../Api/**/*.cs;../Sync/**/*.cs;../Tasks/**/*.cs" />
  </ItemGroup>
</Project>
