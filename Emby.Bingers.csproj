<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Emby.Bingers</RootNamespace>
    <AssemblyName>Emby.Bingers</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Two-way sync of watched movies and episodes between Emby and Bingers (bingers.app).</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Emby loads only this assembly; nothing else needs to be copied to the plugins folder. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="thumb.png" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official Emby plugin SDK. Compile-time only: Emby provides these assemblies at runtime.
         If your server is older or newer and the build or load fails, set this to your server's version. -->
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- The SDK's public types use Span/Memory, which netstandard2.0 lacks. Also compile-time only. -->
    <PackageReference Include="System.Memory" Version="4.6.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
